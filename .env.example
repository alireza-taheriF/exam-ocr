# =============================================================================
# Exam OCR — OpenAI (ChatGPT API) only
# =============================================================================
# Copy to .env and set your key:
#   cp .env.example .env
#
#   OPENAI_API_KEY=sk-proj-...
#   python scripts/configure_openai_labeling.py
# =============================================================================

# --- OpenAI / ChatGPT API (required) ---
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL=gpt-4o-mini
# Only if you bought the key from a reseller/proxy (not platform.openai.com):
# OPENAI_BASE_URL=https://your-provider.com/v1
#
# JustWoker (OpenAI-compatible chat completions — not Anthropic-native):
# JUSTWOKER_API_KEY=sk-...
# JUSTWOKER_BASE_URL=https://api.justwoker.icu/v1
# OPENAI_MODEL=gpt-5.6-sol
#
# AgentRouter (https://agentrouter.org/console/token) — do not reuse this
# variable for JustWoker; they are different providers:
# OPENAI_BASE_URL=https://agentrouter.org/v1
# OPENAI_MODEL=gpt-5

# Set by configure_openai_labeling.py (do not point to OpenRouter/Gemini):
LABEL_OPENAI_ONLY=true
LABEL_PROVIDER=openai
LABEL_DIRECT_OPENROUTER=false

VISION_API_BASE=https://api.openai.com/v1
VISION_API_KEY=sk-proj-your-key-here
VISION_MODEL=gpt-4o-mini

VLM_API_BASE=https://api.justwoker.icu/v1
VLM_API_KEY=sk-your-justwoker-key-here
VLM_MODEL=gpt-5.6-sol

# OCR tuning (handwriting)
OCR_MIN_CROP_HEIGHT=64
OCR_UPSCALE_FACTOR=2.0

# --- Student editing app (main.py) ---
# OCR engine per line: qwen_local (best measured, needs requirements-qwen.txt) | vlm | fake (demo/tests)
OCR_ENGINE=qwen_local
# QWEN_MODEL=mohajesmaeili/Qwen3-VL-2B-Persian-Arabic-Ocr-v1.0
# QWEN_DEVICE=mps            # mps on Apple Silicon, cpu otherwise (auto-detected)
# QWEN_ADAPTER_PATH=models/qwen-lora-v1   # LoRA adapter from Colab, once it passes the eval gate
# Line segmentation: auto (surya if installed, else opencv) | surya | opencv
SEGMENTER=auto
# Lines below this confidence are highlighted for review
LOW_CONFIDENCE_THRESHOLD=0.6
# Correction memory: a substitution becomes active after this many independent students...
MEMORY_MIN_AUTHORS=3
# ...and when it is right this often among reviewed lines that contained it
MEMORY_MIN_PRECISION=0.9
# Fraction of documents kept out of learning for honest measurement (set 0 for a live demo)
HOLDOUT_FRACTION=0.1
# Where the SQLite DB, uploads and line crops live
# DATA_DIR=data
